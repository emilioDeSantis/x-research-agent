# Required — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Grok x_search (recommended) — https://console.x.ai
XAI_API_KEY=
# Official X API, pay-per-use (optional) — https://developer.x.com  → App → Bearer Token
X_BEARER_TOKEN=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# GROK_MODEL=grok-4.7
# GROK_MAX_TURNS=1   # search rounds per Grok call; higher finds more but costs more

# Shared GitHub repo: finished deep/max research is saved to its deep-research/ folder,
# noted in chat.md, and pushed. Leave SHARED_REPO_DIR empty to turn this off.
SHARED_REPO_DIR=
SHARED_REPO_ME=Emilio
SHARED_REPO_THEM=Zeke
# SHARED_REPO_DEPTHS=deep,max
